# Notion internal integration secret. Create one at notion.so/my-integrations
# and share it with the Website Leads database.
NOTION_API_KEY=

# Resend API key from resend.com, used to email requested resources to leads.
RESEND_API_KEY=

# The "from" address for resource emails. Must be on a domain verified in Resend.
RESEND_FROM_EMAIL=
